table dim_marketing_channel

	column channel_key
		dataType: int64
		isHidden
		sourceColumn: channel_key

	column origin
		dataType: string
		sourceColumn: origin

	column channel_group
		dataType: string
		sourceColumn: channel_group

	column is_recorded_origin
		dataType: int64
		sourceColumn: is_recorded_origin

	partition dim_marketing_channel = m
		mode: import
		source =
			let
				Source = MySQL.Database("localhost", "commerceiq", [ReturnSingleDatabase=true]),
				Data = Source{[Schema="commerceiq", Item="dim_marketing_channel"]}[Data],
				TypedFlags = Table.TransformColumns(Data, {{"is_recorded_origin", each if _ = null then null else Int64.From(_), Int64.Type}})
			in
				TypedFlags
