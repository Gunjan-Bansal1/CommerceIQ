table dim_geography

	column geo_key
		dataType: int64
		isHidden
		sourceColumn: geo_key

	column zip_code_prefix
		dataType: string
		sourceColumn: zip_code_prefix

	column city
		dataType: string
		dataCategory: City
		sourceColumn: city

	column state
		dataType: string
		dataCategory: StateOrProvince
		sourceColumn: state

	column region
		dataType: string
		sourceColumn: region

	column latitude
		dataType: double
		dataCategory: Latitude
		sourceColumn: latitude

	column longitude
		dataType: double
		dataCategory: Longitude
		sourceColumn: longitude

	column is_ambiguous_zip
		dataType: int64
		sourceColumn: is_ambiguous_zip

	column dominant_location_pct
		dataType: double
		sourceColumn: dominant_location_pct

	column has_geolocation_match
		dataType: int64
		sourceColumn: has_geolocation_match

	column state_brazil = dim_geography[state] & ", Brazil"
		dataType: string
		dataCategory: StateOrProvince

	partition dim_geography = m
		mode: import
		source =
			let
				Source = MySQL.Database("localhost", "commerceiq", [ReturnSingleDatabase=true]),
				Data = Source{[Schema="commerceiq", Item="dim_geography"]}[Data]
			in
				Data
