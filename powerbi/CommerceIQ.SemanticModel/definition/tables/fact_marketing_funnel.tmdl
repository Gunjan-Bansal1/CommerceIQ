	column lead_type
		dataType: string
		sourceColumn: lead_type

	column business_type
		dataType: string
		sourceColumn: business_type

	column sdr_id
		dataType: string
		sourceColumn: sdr_id

	column sr_id
		dataType: string
		sourceColumn: sr_id

	partition fact_marketing_funnel = m
		mode: import
		source =
			let
				Source = MySQL.Database("localhost", "commerceiq", [ReturnSingleDatabase=true]),
				Data = Source{[Schema="commerceiq", Item="fact_marketing_funnel"]}[Data],
				TypedFlags = Table.TransformColumns(Data, {{"has_closed_deal", each if _ = null then null else Int64.From(_), Int64.Type}, {"has_marketplace_seller_match", each if _ = null then null else Int64.From(_), Int64.Type}, {"is_valid_conversion_duration", each if _ = null then null else Int64.From(_), Int64.Type}})
			in
				TypedFlags
