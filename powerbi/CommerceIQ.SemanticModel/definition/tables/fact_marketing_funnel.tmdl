		isHidden
		sourceColumn: mql_sk

	column mql_id
		dataType: string
		sourceColumn: mql_id

	column channel_key
		dataType: int64
		isHidden
		sourceColumn: channel_key

	column first_contact_date_key
		dataType: int64
		isHidden
		sourceColumn: first_contact_date_key

	column won_date_key
		dataType: int64
		isHidden
		sourceColumn: won_date_key

	column seller_key
		dataType: int64
		isHidden
		sourceColumn: seller_key

	column has_closed_deal
		dataType: int64
		sourceColumn: has_closed_deal

	column has_marketplace_seller_match
		dataType: int64
		sourceColumn: has_marketplace_seller_match

	column conversion_duration_days
		dataType: double
		sourceColumn: conversion_duration_days

	column is_valid_conversion_duration
		dataType: int64
		sourceColumn: is_valid_conversion_duration

	column declared_monthly_revenue
		dataType: decimal
		formatString: "#,##0.00"
