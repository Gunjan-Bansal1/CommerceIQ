table forecast_outputs

	column week_start
		dataType: dateTime
		sourceColumn: week_start

	column actual_value
		dataType: double
		sourceColumn: actual_value

	column target
		dataType: string
		sourceColumn: target

	column record_type
		dataType: string
		sourceColumn: record_type

	column model
		dataType: string
		sourceColumn: model

	column predicted_value
		dataType: double
		sourceColumn: predicted_value

	column ci_lower_95
		dataType: double
		sourceColumn: ci_lower_95

	column ci_upper_95
		dataType: double
		sourceColumn: ci_upper_95

	partition forecast_outputs = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents("C:\Users\bgunj\Desktop\commerceIQ\data\processed\forecast_outputs.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true])
			in
				PromotedHeaders
