table dim_customer

	column customer_key
		dataType: int64
		isHidden
		sourceColumn: customer_key

	column customer_id
		dataType: string
		sourceColumn: customer_id

	column customer_unique_id
		dataType: string
		sourceColumn: customer_unique_id

	column customer_zip_code_prefix
		dataType: string
		sourceColumn: customer_zip_code_prefix

	column customer_city
		dataType: string
		sourceColumn: customer_city

	column customer_state
		dataType: string
		sourceColumn: customer_state

	column customer_region
		dataType: string
		sourceColumn: customer_region

	column geo_key
		dataType: int64
		isHidden
		sourceColumn: geo_key

	column has_geolocation_match
		dataType: int64
		sourceColumn: has_geolocation_match

	column customer_order_seq
		dataType: int64
		sourceColumn: customer_order_seq

	column customer_lifetime_orders
		dataType: int64
		sourceColumn: customer_lifetime_orders

	column is_repeat_customer
		dataType: int64
		sourceColumn: is_repeat_customer

	partition dim_customer = m
		mode: import
		source =
			let
				Source = MySQL.Database("localhost", "commerceiq", [ReturnSingleDatabase=true]),
				Data = Source{[Schema="commerceiq", Item="dim_customer"]}[Data],
				TypedFlags = Table.TransformColumns(Data, {{"has_geolocation_match", each if _ = null then null else Int64.From(_), Int64.Type}, {"is_repeat_customer", each if _ = null then null else Int64.From(_), Int64.Type}})
			in
				TypedFlags
