table decision_scenarios

	column scenario_id
		dataType: string
		sourceColumn: scenario_id

	column scenario_name
		dataType: string
		sourceColumn: scenario_name

	column tier
		dataType: string
		sourceColumn: tier

	column observed_baseline_label
		dataType: string
		sourceColumn: observed_baseline_label

	column observed_baseline_value
		dataType: double
		sourceColumn: observed_baseline_value

	column assumed_input_parameter
		dataType: double
		sourceColumn: assumed_input_parameter

	column driver_unit
		dataType: string
		sourceColumn: driver_unit

	column illustrative_margin_assumption
		dataType: double
		sourceColumn: illustrative_margin_assumption

	column illustrative_intervention_cost_brl
		dataType: double
		sourceColumn: illustrative_intervention_cost_brl

	column simulated_gmv_or_savings_brl
		dataType: double
		sourceColumn: simulated_gmv_or_savings_brl

	column simulated_illustrative_contribution_brl
		dataType: double
		sourceColumn: simulated_illustrative_contribution_brl

	column simulated_illustrative_net_benefit_brl
		dataType: double
		sourceColumn: simulated_illustrative_net_benefit_brl

	column is_illustrative_simulation
		dataType: boolean
		sourceColumn: is_illustrative_simulation

	partition decision_scenarios = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents("C:\Users\bgunj\Desktop\commerceIQ\data\processed\decision_scenarios.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				TypedTable = Table.TransformColumnTypes(PromotedHeaders, {{"scenario_id", type text}, {"scenario_name", type text}, {"tier", type text}, {"observed_baseline_label", type text}, {"observed_baseline_value", type number}, {"assumed_input_parameter", type number}, {"driver_unit", type text}, {"illustrative_margin_assumption", type number}, {"illustrative_intervention_cost_brl", type number}, {"simulated_gmv_or_savings_brl", type number}, {"simulated_illustrative_contribution_brl", type number}, {"simulated_illustrative_net_benefit_brl", type number}, {"is_illustrative_simulation", type logical}}, "en-US")
			in
				TypedTable
