table delivery_risk_predictions

	column order_id
		dataType: string
		sourceColumn: order_id

	column order_purchase_timestamp
		dataType: dateTime
		sourceColumn: order_purchase_timestamp

	column customer_state
		dataType: string
		sourceColumn: customer_state

	column seller_state
		dataType: string
		sourceColumn: seller_state

	column customer_region
		dataType: string
		sourceColumn: customer_region

	column seller_region
		dataType: string
		sourceColumn: seller_region

	column estimated_delivery_days
		dataType: double
		sourceColumn: estimated_delivery_days

	column approx_distance_km
		dataType: double
		sourceColumn: approx_distance_km

	column is_late
		dataType: int64
		sourceColumn: is_late

	column predicted_late_prob
		dataType: double
		sourceColumn: predicted_late_prob

	column predicted_high_risk_flag
		dataType: int64
		sourceColumn: predicted_high_risk_flag

	column risk_tier
		dataType: string
		sourceColumn: risk_tier

	partition delivery_risk_predictions = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents("C:\Users\bgunj\Desktop\commerceIQ\data\processed\delivery_risk_predictions.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true])
			in
				PromotedHeaders
