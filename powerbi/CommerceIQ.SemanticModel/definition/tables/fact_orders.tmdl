table fact_orders

	column order_key
		dataType: int64
		isHidden
		sourceColumn: order_key

	column order_id
		dataType: string
		sourceColumn: order_id

	column customer_key
		dataType: int64
		isHidden
		sourceColumn: customer_key

	column customer_geo_key
		dataType: int64
		isHidden
		sourceColumn: customer_geo_key

	column purchase_date_key
		dataType: int64
		isHidden
		sourceColumn: purchase_date_key

	column delivered_date_key
		dataType: int64
		isHidden
		sourceColumn: delivered_date_key

	column estimated_date_key
		dataType: int64
		isHidden
		sourceColumn: estimated_date_key

	column order_status
		dataType: string
		sourceColumn: order_status

	column is_delivered
		dataType: int64
		sourceColumn: is_delivered

	column is_canceled
		dataType: int64
		sourceColumn: is_canceled

	column is_unavailable
		dataType: int64
		sourceColumn: is_unavailable

	column is_unsuccessful
		dataType: int64
		sourceColumn: is_unsuccessful

	column is_core_reporting_period
		dataType: int64
		sourceColumn: is_core_reporting_period

	column purchase_year_month
		dataType: string
		sourceColumn: purchase_year_month

	column purchase_hour
		dataType: int64
		sourceColumn: purchase_hour

	column has_order_items
		dataType: int64
		sourceColumn: has_order_items

	column has_payment_records
		dataType: int64
		sourceColumn: has_payment_records

	column has_review_records
		dataType: int64
		sourceColumn: has_review_records

	column item_count
		dataType: int64
		sourceColumn: item_count

	column distinct_products
		dataType: int64
		sourceColumn: distinct_products

	column distinct_sellers
		dataType: int64
		sourceColumn: distinct_sellers

	column merchandise_value
		dataType: decimal
		formatString: "#,##0.00"
		sourceColumn: merchandise_value

	column freight_value
		dataType: decimal
		formatString: "#,##0.00"
		sourceColumn: freight_value

	column item_total_value
		dataType: decimal
		formatString: "#,##0.00"
		sourceColumn: item_total_value

	column payment_record_count
		dataType: int64
		sourceColumn: payment_record_count

	column total_payment_value
		dataType: decimal
		formatString: "#,##0.00"
		sourceColumn: total_payment_value

	column max_installments
		dataType: int64
		sourceColumn: max_installments

	column primary_payment_type
		dataType: string
		sourceColumn: primary_payment_type

	column payment_discrepancy_brl
		dataType: decimal
		formatString: "#,##0.00"
		sourceColumn: payment_discrepancy_brl

	column review_count
		dataType: int64
		sourceColumn: review_count

	column avg_review_score
		dataType: double
		sourceColumn: avg_review_score

	column min_review_score
		dataType: int64
		sourceColumn: min_review_score

	column has_written_review
		dataType: int64
		sourceColumn: has_written_review

	column approval_duration_hours
		dataType: double
		sourceColumn: approval_duration_hours

	column processing_duration_days
		dataType: double
		sourceColumn: processing_duration_days

	column transit_duration_days
		dataType: double
		sourceColumn: transit_duration_days

	column delivery_duration_days
		dataType: double
		sourceColumn: delivery_duration_days

	column estimated_delivery_days
		dataType: double
		sourceColumn: estimated_delivery_days

	column delivery_deviation_days
		dataType: int64
		sourceColumn: delivery_deviation_days

	column is_valid_delivery_promise_comparison
		dataType: int64
		sourceColumn: is_valid_delivery_promise_comparison

	column is_on_time_delivery
		dataType: int64
		sourceColumn: is_on_time_delivery

	column delivery_performance
		dataType: string
		sourceColumn: delivery_performance

	partition fact_orders = m
		mode: import
		source =
			let
				Source = MySQL.Database("localhost", "commerceiq", [ReturnSingleDatabase=true]),
				Data = Source{[Schema="commerceiq", Item="fact_orders"]}[Data]
			in
				Data
